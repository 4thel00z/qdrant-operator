  {
    "name": "scheduling and pod metadata",
    "spec": {
      "affinity": {
        "nodeAffinity": {
          "requiredDuringSchedulingIgnoredDuringExecution": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "zone",
                    "operator": "In",
                    "values": [
                      "a",
                      "b"
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "nodeSelector": {
        "pool": "qdrant"
      },
      "podAnnotations": {
        "a": "1"
      },
      "podLabels": {
        "team": "search"
      },
      "tolerations": [
        {
          "effect": "NoSchedule",
          "key": "dedicated",
          "operator": "Equal",
          "value": "qdrant"
        },
        {
          "key": "spot",
          "operator": "Exists",
          "tolerationSeconds": 30
        }
      ],
      "version": "v1.13.0"
    },
    "values": {
      "affinity": {
        "nodeAffinity": {
          "requiredDuringSchedulingIgnoredDuringExecution": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
