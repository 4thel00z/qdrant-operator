[
  {"name": "minimal", "spec": {"version": "v1.13.0"}},
  {"name": "three replicas", "spec": {"version": "v1.13.0", "replicas": 3}},
  {"name": "image and resources", "spec": {"version": "1.12.4", "image": {"repository": "registry.local/qdrant", "pullPolicy": "Always"}, "resources": {"requests": {"cpu": "500m", "memory": "1Gi"}, "limits": {"memory": "2Gi"}}}},
  {"name": "persistence", "spec": {"version": "v1.13.0", "persistence": {"size": "50Gi", "storageClassName": "fast", "accessModes": ["ReadWriteOnce"], "reclaimPolicy": "Delete"}, "snapshotPersistence": {"enabled": true, "size": "20Gi", "storageClassName": "slow"}}},
  {"name": "single node mode", "spec": {"version": "v1.13.0", "cluster": {"enabled": false}}},
  {"name": "p2p port", "spec": {"version": "v1.13.0", "replicas": 3, "cluster": {"p2p": {"port": 7000}}}},
  {"name": "tls without p2p tls", "spec": {"version": "v1.13.0", "tls": {"enabled": true, "secretRef": {"name": "qdrant-tls"}}}},
  {"name": "tls with p2p tls and ca key", "spec": {"version": "v1.13.0", "replicas": 3, "cluster": {"p2p": {"enableTls": true}}, "tls": {"enabled": true, "secretRef": {"name": "qdrant-tls"}, "caKey": "root.pem"}}},
  {"name": "tls enabled without secret", "spec": {"version": "v1.13.0", "tls": {"enabled": true}}},
  {"name": "api key from secret with jwt rbac", "spec": {"version": "v1.13.0", "apiKey": {"secretRef": {"name": "keys", "key": "admin"}, "jwtRbac": true}, "readOnlyApiKey": {"secretRef": {"name": "keys", "key": "reader"}}}},
  {"name": "generated api keys", "spec": {"version": "v1.13.0", "apiKey": {"autoGenerate": true}, "readOnlyApiKey": {"autoGenerate": true}}},
  {"name": "service and metrics", "spec": {"version": "v1.13.0", "service": {"type": "LoadBalancer", "annotations": {"lb": "internal"}}, "metrics": {"enabled": true, "serviceMonitor": {"enabled": true, "interval": "15s", "labels": {"release": "prom"}}}}},
  {"name": "service monitor without metrics", "spec": {"version": "v1.13.0", "metrics": {"serviceMonitor": {"enabled": true}}}},
  {"name": "scheduling and pod metadata", "spec": {"version": "v1.13.0", "nodeSelector": {"pool": "qdrant"}, "tolerations": [{"key": "dedicated", "operator": "Equal", "value": "qdrant", "effect": "NoSchedule"}, {"key": "spot", "operator": "Exists", "tolerationSeconds": 30}], "affinity": {"nodeAffinity": {"requiredDuringSchedulingIgnoredDuringExecution": {"nodeSelectorTerms": [{"matchExpressions": [{"key": "zone", "operator": "In", "values": ["a", "b"]}]}]}}}, "podAnnotations": {"a": "1"}, "podLabels": {"team": "search"}}},
  {"name": "pdb min available", "spec": {"version": "v1.13.0", "replicas": 3, "podDisruptionBudget": {"minAvailable": 2}}},
  {"name": "pdb max unavailable percent", "spec": {"version": "v1.13.0", "replicas": 5, "podDisruptionBudget": {"maxUnavailable": "40%"}}},
  {"name": "pdb forced on single replica", "spec": {"version": "v1.13.0", "podDisruptionBudget": {"enabled": true}}},
  {"name": "pdb disabled", "spec": {"version": "v1.13.0", "replicas": 3, "podDisruptionBudget": {"enabled": false}}},
  {"name": "zone spread", "spec": {"version": "v1.13.0", "replicas": 3, "topologySpread": {"hostname": {"maxSkew": 2, "whenUnsatisfiable": "DoNotSchedule"}, "zone": {"enabled": true}}}},
  {"name": "hostname spread off", "spec": {"version": "v1.13.0", "replicas": 3, "topologySpread": {"hostname": {"enabled": false}}}},
  {"name": "explicit constraints", "spec": {"version": "v1.13.0", "replicas": 3, "topologySpread": {"constraints": [{"maxSkew": 1, "topologyKey": "rack", "whenUnsatisfiable": "DoNotSchedule"}]}}},
  {"name": "explicit empty constraints", "spec": {"version": "v1.13.0", "replicas": 3, "topologySpread": {"constraints": []}}},
  {"name": "constraints on one replica", "spec": {"version": "v1.13.0", "topologySpread": {"constraints": [{"maxSkew": 1, "topologyKey": "rack", "whenUnsatisfiable": "ScheduleAnyway"}]}}},
  {"name": "config merges over defaults", "spec": {"version": "v1.13.0", "replicas": 3, "minReadySeconds": 10, "config": {"cluster": {"p2p": {"port": 9999}, "consensus": {"tick_period_ms": 50}}, "storage": {"performance": {"max_search_threads": 4}}, "service": {"max_request_size_mb": 64}}}},
  {"name": "config overrides tls block", "spec": {"version": "v1.13.0", "tls": {"enabled": true, "secretRef": {"name": "qdrant-tls"}}, "config": {"tls": {"cert_ttl": 3600}}}},
  {"name": "rollout and scaling do not render", "spec": {"version": "v1.13.0", "replicas": 2, "rollout": {"strategy": "Readiness"}, "scaling": {"drainOnScaleDown": true, "removeDeadPeers": true, "rebalance": true}}}
]
